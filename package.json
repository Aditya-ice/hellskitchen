{
  "name": "hellskitchen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "cargo run -q -p ember-server",
    "brain": "uv run --project services/brain uvicorn brain.app:app --host 127.0.0.1 --port 4100",
    "desktop": "cargo run -q -p ember-desktop",
    "build": "EMBER_EXPORT=1 next build",
    "build:server": "cargo build --release -p ember-server",
    "desktop:build": "npm run build && tauri build",
    "start": "npm run build && npm run build:server && EMBER_STATIC_DIR=./out ./target/release/ember-server",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test",
    "test:all": "npm run test && npm run test:rust"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.17.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
