{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember POS",
  "version": "0.1.0",
  "identifier": "com.emberpos.desktop",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Business",
    "shortDescription": "AI-assisted front of house",
    "longDescription": "Seat parties, surface guest allergies, and build safe orders with explainable recommendations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": [
      "../out"
    ]
  }
}
