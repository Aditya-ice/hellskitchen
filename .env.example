# Server-only sponsor keys. These are read by ember-server (Rust) and never
# reach the browser.
ELEVENLABS_API_KEY=
TAVILY_API_KEY=

# Point the sponsor proxies at a stub to exercise them without real
# credentials. Leave unset to use the real APIs.
# EMBER_ELEVENLABS_BASE=http://127.0.0.1:4320
# EMBER_TAVILY_BASE=http://127.0.0.1:4320

# Server
EMBER_PORT=4000
EMBER_DB=./ember.db
# Directory holding the exported UI (`npm run build` writes ./out).
# EMBER_STATIC_DIR=./out
# Set when serving over https, so the session cookie is marked Secure.
# EMBER_SECURE_COOKIES=1

# Optional Python service. The POS runs fine without it.
# EMBER_BRAIN_URL=http://127.0.0.1:4100

# Where `next dev` proxies /api/* to.
# EMBER_API=http://127.0.0.1:4000

# Public Stay22 map configuration
NEXT_PUBLIC_STAY22_AID=
NEXT_PUBLIC_RESTAURANT_VENUE="Fordham University, Lincoln Center, New York"
