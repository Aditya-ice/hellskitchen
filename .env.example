# Server-only sponsor keys. These are read by ember-server (Rust) and never
# reach the browser.
ELEVENLABS_API_KEY=
TAVILY_API_KEY=

# Point the sponsor proxies at a stub to exercise them without real
# credentials. Leave unset to use the real APIs.
# EMBER_ELEVENLABS_BASE=http://127.0.0.1:4320
# EMBER_TAVILY_BASE=http://127.0.0.1:4320

# Server
# Bind address. Defaults to loopback, so the standalone server is NOT reachable
# from the rest of the network until this is set.
# EMBER_HOST=0.0.0.0
EMBER_PORT=4000
# Leave this unset and the server keeps the whole service in memory: a restart
# loses the night. Always set it outside a throwaway dev run.
EMBER_DB=./ember.db
# Directory holding the exported UI (`npm run build` writes ./out).
# EMBER_STATIC_DIR=./out
# Set when serving over https, so the session cookie is marked Secure.
# EMBER_SECURE_COOKIES=1
# Believe X-Forwarded-For. Only set this behind a proxy that actually sets it:
# otherwise any client can pick its own rate-limit identity by sending it.
# EMBER_TRUST_PROXY=1

# Optional Python service (services/brain). The POS runs fine without it.
# EMBER_BRAIN_URL=http://127.0.0.1:4100

# Read by the brain service itself, never by ember-server or the browser.
# Either of these counts as a credential, as does a populated ~/.config/anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# EMBER_URL=http://127.0.0.1:4000      # where the brain reads the floor from
# EMBER_BRAIN_MODEL=claude-opus-5
# EMBER_BRAIN_EFFORT=medium            # low | medium | high | xhigh | max
#                                      # an unknown value is refused at startup

# Where `next dev` proxies /api/* to.
# EMBER_API=http://127.0.0.1:4000
# Baked into the bundle at build time; only needed when the UI is served from a
# different origin than the API. The desktop app and `npm start` do not use it.
# NEXT_PUBLIC_EMBER_API=

# Set by `npm run build` to produce a static export. Not something to set by hand.
# EMBER_EXPORT=1

# Public Stay22 map configuration
NEXT_PUBLIC_STAY22_AID=
NEXT_PUBLIC_RESTAURANT_VENUE="Fordham University, Lincoln Center, New York"
